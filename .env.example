# ==============================================================================
# SIH26166 Lunar Image Registration - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Project Connection
# Replace with your project details from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Supabase Storage Buckets
STORAGE_BUCKET_RAW=lunar-raw
STORAGE_BUCKET_METADATA=lunar-metadata
STORAGE_BUCKET_PROCESSED=lunar-processed
STORAGE_BUCKET_RESULTS=lunar-results

# Direct PostgreSQL / PostGIS Database Connection (Optional if using Supabase REST API)
POSTGRES_HOST=db.your-project-id.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Local Storage Cache Paths
DATA_RAW_DIR=./data/raw
DATA_EXTRACTED_DIR=./data/extracted
DATA_PROCESSED_DIR=./data/processed
DATA_REPORTS_DIR=./reports

# Quality Control Thresholds
QC_MAX_NODATA_PERCENT=40.0
QC_MAX_SATURATION_PERCENT=10.0
QC_MIN_VARIANCE_THRESHOLD=1e-5
